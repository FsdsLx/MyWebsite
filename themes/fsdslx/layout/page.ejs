<% if (page.type === 'tags') { %>
<section class="page-head">
  <p class="kicker">TAGS</p>
  <h1 class="page-title">标签</h1>
  <p class="page-lead">按标签浏览全部文章。</p>
</section>
<section class="hub">
  <% if (!site.tags.length) { %>
    <p class="empty">还没有标签。</p>
  <% } %>
  <% site.tags.each(function(t){ if (t.length) { %>
  <a class="hub-row" href="<%- url_for(t.path) %>">
    <span class="hub-name"><%= t.name %></span>
    <span class="hub-count"><%= t.length %> 篇</span>
  </a>
  <% } }); %>
</section>
<% } else if (page.type === 'categories') { %>
<section class="page-head">
  <p class="kicker">CATEGORIES</p>
  <h1 class="page-title">分类</h1>
  <p class="page-lead">按分类浏览全部文章。</p>
</section>
<section class="hub">
  <% if (!site.categories.length) { %>
    <p class="empty">还没有分类。</p>
  <% } %>
  <% site.categories.each(function(c){ if (c.length) { %>
  <a class="hub-row" href="<%- url_for(c.path) %>">
    <span class="hub-name"><%= c.name %></span>
    <span class="hub-count"><%= c.length %> 篇</span>
  </a>
  <% } }); %>
</section>
<% } else { %>
<article class="post">
  <header class="page-head">
    <p class="kicker">FSDSLX</p>
    <h1 class="page-title"><%= page.title %></h1>
  </header>
  <div class="prose">
    <%- page.content %>
  </div>
</article>
<% } %>
